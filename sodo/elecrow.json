{
  "board_id": "elecrow",
  "board_name": "Elecrow Terminal (ESP32)",
  "chip": "ESP32",
  "notes": "Dòng bo mạch màn hình cảm ứng Elecrow CrowPanel ESP32 HMI (2.4\", 2.8\", 3.5\"), trang bị chip ESP32 4MB Flash, màn hình cảm ứng điện trở XPT2046 qua bus HSPI, khe thẻ nhớ MicroSD riêng qua bus VSPI và cổng mở rộng I2C.",
  "modules": [
    {
      "name": "1. Màn hình TFT (HSPI)",
      "subtitle": "TFT Display ↔ ESP32 (HSPI)",
      "icon": "fa-tv",
      "pins": [
        {
          "pin": "TFT MOSI",
          "esp": "GPIO 13"
        },
        {
          "pin": "TFT MISO",
          "esp": "GPIO 12"
        },
        {
          "pin": "TFT SCLK",
          "esp": "GPIO 14"
        },
        {
          "pin": "TFT CS",
          "esp": "GPIO 15"
        },
        {
          "pin": "TFT DC",
          "esp": "GPIO 2"
        },
        {
          "pin": "TFT BL (Đèn nền)",
          "esp": "GPIO 27"
        }
      ]
    },
    {
      "name": "2. Cảm ứng Điện trở XPT2046",
      "subtitle": "Touch Controller (HSPI Shared)",
      "icon": "fa-hand-pointer",
      "pins": [
        {
          "pin": "Touch CS",
          "esp": "GPIO 33"
        },
        {
          "pin": "Touch IRQ (Ngắt chạm)",
          "esp": "GPIO 36"
        },
        {
          "pin": "Touch SPI (SCK/MISO/MOSI)",
          "esp": "Dùng chung HSPI (GPIO 14, 12, 13)"
        }
      ]
    },
    {
      "name": "3. Thẻ nhớ MicroSD (VSPI)",
      "subtitle": "MicroSD ↔ ESP32 (VSPI)",
      "icon": "fa-sd-card",
      "pins": [
        {
          "pin": "SD CS",
          "esp": "GPIO 5"
        },
        {
          "pin": "SD SCK",
          "esp": "GPIO 18"
        },
        {
          "pin": "SD MISO",
          "esp": "GPIO 19"
        },
        {
          "pin": "SD MOSI",
          "esp": "GPIO 23"
        }
      ]
    },
    {
      "name": "4. Cổng mở rộng I2C & Serial",
      "subtitle": "I2C Bus & UART",
      "icon": "fa-plug",
      "pins": [
        {
          "pin": "I2C SDA / SCL",
          "esp": "GPIO 21 (SDA), GPIO 22 (SCL)"
        },
        {
          "pin": "UART TX / RX",
          "esp": "GPIO 1, GPIO 3"
        }
      ]
    }
  ]
}