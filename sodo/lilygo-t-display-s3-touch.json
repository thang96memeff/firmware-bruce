    },
    {
      "name": "8. Module CC1101",
      "subtitle": "CC1101 Pin ↔ ESP32-S3",
      "icon": "fa-radio",
      "pins": [
        {"pin": "VCC", "esp": "3.3V"},
        {"pin": "GND", "esp": "GND"},
        {"pin": "SCK", "esp": "GPIO 43"},
        {"pin": "MOSI", "esp": "GPIO 3"},
        {"pin": "MISO", "esp": "GPIO 2"},
        {"pin": "CSN", "esp": "GPIO 1"},
        {"pin": "GDO0", "esp": "GPIO 44"}
