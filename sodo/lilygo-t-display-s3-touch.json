{
  "board_id": "lilygo-t-display-s3-touch",
  "board_name": "LilyGO T-Display S3 Touch",
  "chip": "ESP32-S3",
  "notes": "LilyGO T-Display S3 phiên bản Cảm ứng điện dung (CST816S ProTouch). Chân NRF24 và CC1101 được dời tối ưu để không trùng chân cảm ứng I2C (GPIO 17, 18).",
  "modules": [
    {
      "name": "1. Màn hình TFT & Cảm ứng",
      "subtitle": "TFT Pin ↔ ESP32-S3 (Parallel 8-Bit + I2C Touch)",
      "icon": "fa-mobile-screen",
      "pins": [
        {"pin": "VCC", "esp": "3.3V (Onboard)"},
        {"pin": "GND", "esp": "GND"},
        {"pin": "SCL", "esp": "GPIO 8 (WR) / GPIO 9 (RD)"},
        {"pin": "SDA", "esp": "D0-D7 (GPIO 39, 40, 41, 42, 45, 46, 47, 48)"},
        {"pin": "RES", "esp": "GPIO 5"},
        {"pin": "DC", "esp": "GPIO 7"},
        {"pin": "CS", "esp": "GPIO 6"},
        {"pin": "BLK", "esp": "GPIO 38 (Backlight)"}
      ]
    },
    {
      "name": "2. Nút nhấn & Cảm ứng",
      "subtitle": "Button ↔ ESP32-S3 GPIO",
      "icon": "fa-gamepad",
      "pins": [
        {"pin": "SELECT", "esp": "Cảm ứng màn hình / GPIO 14"},
        {"pin": "DOWN", "esp": "Cảm ứng vuốt xuống / GPIO 14"},
        {"pin": "UP", "esp": "Cảm ứng vuốt lên / GPIO 0"}
      ]
    },
    {
      "name": "3. Module Hồng ngoại",
      "subtitle": "IR Module ↔ ESP32-S3",
      "icon": "fa-bolt",
      "pins": [
        {"pin": "IR TX (Phát hồng ngoại) - Chân SIG", "esp": "GPIO 3 (TXLED)"},
        {"pin": "IR RX (Thu hồng ngoại) - Chân OUT", "esp": "GPIO 21 (RXLED)"}
      ]
    },
    {
      "name": "4. Module Thẻ nhớ",
      "subtitle": "SD Pin ↔ ESP32-S3",
      "icon": "fa-sd-card",
      "pins": [
        {"pin": "VCC", "esp": "3.3V"},
        {"pin": "GND", "esp": "GND"},
        {"pin": "SCK", "esp": "GPIO 43"},
        {"pin": "MOSI", "esp": "GPIO 3"},
        {"pin": "MISO", "esp": "GPIO 2"},
        {"pin": "CS", "esp": "GPIO 1"}
      ]
    },
    {
      "name": "5. Module BW16",
      "subtitle": "BW16 Pin ↔ ESP32-S3",
      "icon": "fa-wifi",
      "pins": [
        {"pin": "VCC", "esp": "3.3V / 5V"},
        {"pin": "GND", "esp": "GND"},
        {"pin": "PB2", "esp": "GPIO 44 (RX)"},
        {"pin": "PB1", "esp": "GPIO 16 (TX)"}
      ]
    },
    {
      "name": "6. Module GPS",
      "subtitle": "GPS Pin ↔ ESP32-S3",
      "icon": "fa-location-crosshairs",
      "pins": [
        {"pin": "VCC", "esp": "3.3V / 5V"},
        {"pin": "GND", "esp": "GND"},
        {"pin": "TX", "esp": "GPIO 44 (RX)"},
        {"pin": "RX", "esp": "GPIO 16 (TX)"}
      ]
    },
    {
      "name": "7. Module NRF24",
      "subtitle": "NRF24 Pin ↔ ESP32-S3",
      "icon": "fa-tower-broadcast",
      "warning": "⚠️ Lưu ý: Chỉ cấp 3.3V, cấp 5V sẽ gây cháy hỏng module NRF24!",
      "pins": [
        {"pin": "VCC", "esp": "3.3V (Lưu ý: Chỉ cấp 3.3V ⚠️)"},
        {"pin": "GND", "esp": "GND"},
        {"pin": "CE", "esp": "GPIO 44"},
        {"pin": "CSN", "esp": "GPIO 16"},
        {"pin": "SCK", "esp": "GPIO 43"},
        {"pin": "MOSI", "esp": "GPIO 3"},
        {"pin": "MISO", "esp": "GPIO 2"}
