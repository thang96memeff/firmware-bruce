        {"pin": "VCC", "esp": "3.3V (Onboard)"},
        {"pin": "GND", "esp": "GND"},
        {"pin": "SCL", "esp": "GPIO 40"},
        {"pin": "SDA (MOSI)", "esp": "GPIO 41"},
        {"pin": "MISO", "esp": "GPIO 38"},
        {"pin": "RES", "esp": "Quản lý phần cứng tự động"},
        {"pin": "DC", "esp": "GPIO 11"},
        {"pin": "CS", "esp": "GPIO 12"},
        {"pin": "BLK", "esp": "GPIO 42"}
      ]
    },
    {
      "name": "2. Nút nhấn & Bàn phím",
      "subtitle": "Trackball & Keyboard ↔ ESP32-S3",
      "icon": "fa-gamepad",
      "pins": [
        {"pin": "TRACKBALL UP", "esp": "GPIO 3"},
        {"pin": "TRACKBALL DOWN", "esp": "GPIO 15"},
        {"pin": "TRACKBALL LEFT", "esp": "GPIO 1"},
        {"pin": "TRACKBALL RIGHT", "esp": "GPIO 2"},
        {"pin": "TRACKBALL CLICK", "esp": "GPIO 0"},
        {"pin": "BÀN PHÍM MINI I2C", "esp": "SDA: GPIO 18, SCL: GPIO 8"}
      ]
    },
    {
      "name": "3. Module Hồng ngoại",
      "subtitle": "IR Module ↔ ESP32-S3",
      "icon": "fa-bolt",
