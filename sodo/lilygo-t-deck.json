        {"pin": "MOSI", "esp": "GPIO 41"},
        {"pin": "MISO", "esp": "GPIO 38"},
        {"pin": "CS", "esp": "GPIO 39"}
      ]
    },
    {
      "name": "5. Module BW16",
      "subtitle": "BW16 Pin ↔ ESP32-S3",
