        {"pin": "IR TX (Phát hồng ngoại) - Chân SIG", "esp": "GPIO 43 (Header mở rộng)"},
        {"pin": "IR RX (Thu hồng ngoại) - Chân OUT", "esp": "GPIO 44 (Header mở rộng)"}
      ]
    },
    {
      "name": "4. Module Thẻ nhớ",
      "subtitle": "SD Pin ↔ ESP32-S3",
      "icon": "fa-sd-card",
